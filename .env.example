# Copy to .env and edit. Every line is optional.

# Prebuilt image. Or leave it and run `docker compose up -d --build`.
IMAGE=ghcr.io/pgodlews/osvplat:latest

# Run as you, so ./data is yours: `id -u` / `id -g`.
UID=1000
GID=1000

PORT=8090
SAMPLES_DIR=./samples
DATA_DIR=./data
# Optional mask model weights (SAM 3): docs/docker.md "SAM 3 masks".
MODELS_DIR=./models

# Leave empty to have one generated (printed by `docker compose logs queue`).
QUEUE_TOKEN=

# GPUs the queue may use: all, or e.g. 0 or 0,1.
QUEUE_GPUS=all

# Building only: your GPU's compute capability builds much faster than the
# default list, e.g. 8.6 for an RTX 3090, 8.9 for a 4090, 12.0 for a 5090.
# CUDA_ARCH=8.6
# BUILD_JOBS=8
