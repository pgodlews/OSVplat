+TEST(ArgumentParserTest, OpacityRegFlagSetsFieldAndExplicitOverride) {
+    const auto data_path = make_test_path("lfs_arg_parser_opacity_reg_data");
+    const auto output_path = make_test_path("lfs_arg_parser_opacity_reg_output");
+
+    const char* argv[] = {
+        "LichtFeld-Studio",
+        "--headless",
+        "--data-path",
+        data_path.c_str(),
+        "--output-path",
+        output_path.c_str(),
+        "--opacity-reg",
+        "0"};
+
+    auto parsed = lfs::core::args::parse_args_and_params(static_cast<int>(std::size(argv)), argv);
+    ASSERT_TRUE(parsed.has_value()) << parsed.error();
+    EXPECT_FLOAT_EQ((*parsed)->optimization.opacity_reg, 0.0f);
+    EXPECT_TRUE((*parsed)->overrides.has_optimization_key("opacity_reg"));
+
+    lfs::core::param::TrainingParameters restored;
+    restored.optimization.opacity_reg = 0.003f;
+    apply_explicit_training_overrides(restored, (*parsed)->overrides);
+    EXPECT_FLOAT_EQ(restored.optimization.opacity_reg, 0.0f);
+}
