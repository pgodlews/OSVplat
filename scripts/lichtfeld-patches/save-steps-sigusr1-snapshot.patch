+                }
                 std::this_thread::sleep_for(std::chrono::milliseconds(5));
             }
         }
 
+        void start_snapshot_request() {
+            std::lock_guard lock(snapshot_mutex_);
+            if (!snapshot_handler_) {
+                LOG_WARN("SIGUSR1: no training in progress; snapshot request ignored");
+                return;
+            }
+            if (snapshot_busy_.load(std::memory_order_acquire)) {
+                LOG_INFO("SIGUSR1: previous snapshot request still being queued; merged into it");
+                return;
+            }
+            if (snapshot_worker_.joinable()) {
+                snapshot_worker_.join();          // finished: it cleared busy
+            }
+            snapshot_busy_.store(true, std::memory_order_release);
+            snapshot_worker_ = std::jthread([this, handler = snapshot_handler_] {
+                const auto start = std::chrono::steady_clock::now();
+                LOG_INFO("SIGUSR1: project snapshot requested");
+                handler();
+                LOG_INFO("SIGUSR1: snapshot request queued in {} ms",
+                         std::chrono::duration_cast<std::chrono::milliseconds>(
+                             std::chrono::steady_clock::now() - start)
+                             .count());
+                snapshot_busy_.store(false, std::memory_order_release);
+            });
+        }
+
         inline static volatile std::sig_atomic_t pending_signal_ = 0;
+        inline static volatile std::sig_atomic_t pending_snapshot_ = 0;
 
         SignalHandler previous_sigint_ = SIG_DFL;
         SignalHandler previous_sigterm_ = SIG_DFL;
+        SignalHandler previous_sigusr1_ = SIG_DFL;
         std::stop_source stop_source_;
         std::atomic<int> received_signal_{0};
+        std::mutex snapshot_mutex_;
+        std::function<void()> snapshot_handler_;
+        std::atomic<bool> snapshot_busy_{false};
+        std::jthread snapshot_worker_;
         std::jthread monitor_;
     };
 
