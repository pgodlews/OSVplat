+        // SIGUSR1 asks for a project snapshot without stopping training (e.g. on a
+        // spot-reclaim notice). The handler runs on its own worker thread, so a
+        // slow request never delays the SIGTERM/SIGINT the monitor watches for.
+        // With no handler set (before or after train()), the request is logged
+        // and dropped; one arriving while the previous is still being queued is
+        // merged into it.
+        void set_snapshot_handler(std::function<void()> handler) {
+            std::lock_guard lock(snapshot_mutex_);
+            snapshot_handler_ = std::move(handler);
+        }
+
+        // Drops the handler and waits for a request still being queued, so
+        // whatever the handler points at can be torn down afterwards.
+        void clear_snapshot_handler() {
+            std::jthread worker;
+            {
+                std::lock_guard lock(snapshot_mutex_);
+                snapshot_handler_ = {};
+                worker = std::move(snapshot_worker_);
+            }
+            if (worker.joinable()) {
+                worker.join();
+            }
         }
 
